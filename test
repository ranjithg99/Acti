    FROM TABLE(sys.odcivarchar2list(
        '1102803629', '1100202066', '1102825998', '1103051112', '1103327883',
        '1102826484', '1103600342', '1103733055', '1000083170', '1102713267',
        '1102824940', '1102988649', '1102207575', '1101668354', '1102381322',
        '1102554972', '1102408052', '1000082361', '1102945252', '1103780271',
        '1102799970', '1104593602', '1103529592', '1100158312', '1102825427',
        '1102824689', '1103056262', '1000062976'
    ))
