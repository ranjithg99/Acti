    SELECT COLUMN_VALUE AS npi 
    FROM TABLE(sys.odcivarchar2list(
        '1548212988', '1891820668', '1083971204'
    ))
),
query_data AS (
    SELECT DISTINCT 
           rp.mstr_prov_id           AS org_mstr_prov_id,
           rp.prov_org_fed_tax_id    AS tin,
           rp.npi                    AS org_npi,
           rp.prov_org_spclty_cd     AS org_spclty,
           CASE
