ALTER TABLE SPSOWNER.PROV_UPDT_LOG MODIFY
  PARTITION BY RANGE (INSRT_UPDT_DT)
INTERVAL(NUMTOYMINTERVAL(1, 'MONTH'))
( 
   PARTITION p1 VALUES LESS THAN (TO_DATE('4/01/2018', 'MM/DD/YYYY')),
   PARTITION p2 VALUES LESS THAN (TO_DATE('5/01/2018', 'MM/DD/YYYY')))
ONLINE;

/
exec dbms_stats.gather_table_stats('SPSOWNER','PROV_UPDT_LOG',cascade=>true,degree=>4,granularity=>'all',method_opt=>'for all columns size auto',Estimate_Percent => SYS.DBMS_STATS.AUTO_SAMPLE_SIZE);
/
CREATE INDEX SPSOWNER.IDX_INSRTUPDT_DT ON SPSOWNER.PROV_UPDT_LOG(INSRT_UPDT_DT) LOCAL TABLESPACE SPSOWNER_INDEX;
